# DES370K material stays local (raw data, metadata, DESRES license/README);
# splits are regenerated with prepare_data.py
DES370K*
LICENSE.txt
geometries/

# Processed splits and teacher targets (regenerated by prepare_data.py / test_joint.py)
data/
*.npz

# Checkpoints and cached tensors (regenerated; the feature/target caches are
# tens of GiB)
ckpt/
*.pt
*.npy

# Run logs (keep the JSON result records)
logs/*
!logs/*.json

# Cluster scheduler output
*.log
*.lo
training.o*

# Local training launchers
learn*.zsh

# Scheduler / nohup output
*.out
*.err
nohup.out
slurm-*.out

# Python
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/

# Editors and OS
.DS_Store
*.swp
.vscode/
.idea/

# Per-backbone run directories (logs/, ckpt/ and target caches)
runs/

# Local reading material
*.pdf
